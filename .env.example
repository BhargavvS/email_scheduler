NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://scheduler:scheduler@localhost:5432/reachindox_db
REDIS_URL=redis://localhost:6379

# Worker / scheduling defaults (used from B4 onwards).
WORKER_CONCURRENCY=5
MIN_DELAY_MS_BETWEEN_EMAILS=2000
MAX_EMAILS_PER_HOUR=200
MAX_EMAILS_PER_HOUR_PER_SENDER=50

# B6 restart-hardening thresholds.
STUCK_PROCESSING_THRESHOLD_MS=300000
RECONCILE_SWEEP_INTERVAL_MS=60000

# Auth (B2). Replace with real Google OAuth client credentials for Google login.
GOOGLE_CLIENT_ID=google-client-id
GOOGLE_CLIENT_SECRET=google-client-secret
JWT_SESSION_SECRET=dev-only-session-secret-change
FRONTEND_URL="http://localhost:3000"
API_ORIGIN="http://localhost:4000"
SESSION_TTL_DAYS=7