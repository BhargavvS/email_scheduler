    { "dot": "cyan", "title": "Core Invariant", "items": ["Postgres email_jobs is source of truth; BullMQ + Redis is only the scheduling clock", "Frontend never queries Redis — counts, tabs and previews read DB", "DB commit before enqueue → pending survives Redis crash; status: partially_enqueued on Redis-down"] },
    { "dot": "emerald", "title": "Execution & Rate Limiting", "items": ["Per-sender BullMQ queues on Redis sorted set • limiter max:1 / 2s floor + WORKER_CONCURRENCY 5 per worker", "Lua RESERVE enforces global 200/h, per-sender 50/h and per-batch hourlyLimit atomically • defer to next hour with stagger", "Fail-closed on Redis unavailable → 30s delayed retry; never sends unconstrained"] },
    { "dot": "amber", "title": "Resilience & Observability", "items": ["Redis AOF + named volumes survive restart; reconciliation heals pending / queued-unknown / stuck processing on boot and every 60s", "Overdue promotion compensates 2s limiter drift; idempotent jobId email-{cuid} prevents duplicate sends", "GET /health checks pg, redis and worker:heartbeat; pino structured logs + /api/emails/scheduled|sent paginated"] }
